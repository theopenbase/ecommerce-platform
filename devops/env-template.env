# ============================================================
# 电商平台 — 环境配置模板
# ============================================================
# 说明：
# 1. 此文件为各环境的配置模板，复制后按环境命名
# 2. 生产环境敏感信息严禁提交到 Git
# 3. 使用 Kubernetes Secret / SealedSecret 管理密钥
# 4. 应用读取时通过环境变量注入
# ============================================================

# ============================================================
# 通用配置
# ============================================================
# APP_ENV=development|staging|production
# APP_DEBUG=true|false
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ============================================================
# 数据库配置（MySQL / PostgreSQL）
# ============================================================
# DATABASE_URL 格式：
# mysql: mysql+pymysql://user:password@host:3306/dbname
# postgres: postgresql://user:password@host:5432/dbname
{{- if eq .Values.global.environment "production" }}
DATABASE_URL=postgresql://{{ .Values.secrets.dbUser }}:{{ .Values.secrets.dbPassword }}@{{ .Values.database.host }}:{{ .Values.database.port }}/{{ .Values.database.name }}
{{- else }}
DATABASE_URL=postgresql://ecommerce:ecommerce_dev@localhost:5432/ecommerce_dev
{{- end }}

# 连接池配置
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ============================================================
# Redis 配置
# ============================================================
{{- if eq .Values.global.environment "production" }}
REDIS_URL=rediss://:{{ .Values.secrets.redisPassword }}@{{ .Values.redis.host }}:{{ .Values.redis.port }}/0
{{- else }}
REDIS_URL=redis://localhost:6379/0
{{- end }}

# Redis 分库
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_QUEUE_DB=2

# ============================================================
# JWT / 认证配置
# ============================================================
{{- if eq .Values.global.environment "production" }}
JWT_SECRET={{ .Values.secrets.jwtSecret }}
{{- else }}
JWT_SECRET=dev_jwt_secret_change_in_production_abc123
{{- end }}
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ============================================================
# 支付配置（Payment Service）
# ============================================================
{{- if eq .Values.global.environment "production" }}
PAYMENT_WEBHOOK_SECRET={{ .Values.secrets.paymentWebhookSecret }}
ALIPAY_APP_ID={{ .Values.secrets.alipayAppId }}
ALIPAY_PRIVATE_KEY={{ .Values.secrets.alipayPrivateKey }}
WECHAT_PAY_MCH_ID={{ .Values.secrets.wechatMchId }}
{{- else }}
PAYMENT_WEBHOOK_SECRET=dev_webhook_secret
ALIPAY_APP_ID=2021000000000000
ALIPAY_PRIVATE_KEY=/path/to/dev/private_key
WECHAT_PAY_MCH_ID=1234567890
{{- end }}

# ============================================================
# 对象存储配置（MinIO / S3）
# ============================================================
{{- if eq .Values.global.environment "production" }}
S3_ENDPOINT={{ .Values.storage.s3.endpoint }}
S3_ACCESS_KEY={{ .Values.secrets.s3AccessKey }}
S3_SECRET_KEY={{ .Values.secrets.s3SecretKey }}
S3_BUCKET=ecommerce-assets
{{- else }}
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ecommerce-dev
{{- end }}
S3_REGION=cn-north-1

# ============================================================
# 消息队列配置（RabbitMQ / Kafka）
# ============================================================
{{- if eq .Values.global.environment "production" }}
RABBITMQ_URL=amqps://{{ .Values.secrets.rabbitmqUser }}:{{ .Values.secrets.rabbitmqPassword }}@{{ .Values.mq.host }}:{{ .Values.mq.port }}
{{- else }}
RABBITMQ_URL=amqp://guest:guest@localhost:5672
{{- end }}

# Kafka（可选，用于高吞吐场景）
KAFKA_BOOTSTRAP_SERVERS={{ .Values.mq.kafka.bootstrapServers | default "localhost:9092" }}

# ============================================================
# 搜索配置（Elasticsearch）
# ============================================================
{{- if eq .Values.global.environment "production" }}
ELASTICSEARCH_URL=https://{{ .Values.search.host }}:{{ .Values.search.port }}
{{- else }}
ELASTICSEARCH_URL=http://localhost:9200
{{- end }}
ELASTICSEARCH_INDEX_PREFIX=ecommerce

# ============================================================
# 监控与可观测性
# ============================================================
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT={{ .Values.monitoring.otelEndpoint | default "http://localhost:4317" }}
OTEL_SERVICE_NAME={{ .Values.global.serviceName }}
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================
# 第三方服务 Key（各环境不同）
# ============================================================
{{- if eq .Values.global.environment "production" }}
SMS_ACCESS_KEY={{ .Values.secrets.smsAccessKey }}
SMS_ACCESS_SECRET={{ .Values.secrets.smsAccessSecret }}
EMAIL_SMTP_HOST={{ .Values.secrets.emailSmtpHost }}
EMAIL_SMTP_PORT={{ .Values.secrets.emailSmtpPort }}
EMAIL_SMTP_USER={{ .Values.secrets.emailSmtpUser }}
EMAIL_SMTP_PASSWORD={{ .Values.secrets.emailSmtpPassword }}
{{- else }}
SMS_ACCESS_KEY=dev_sms_key
SMS_ACCESS_SECRET=dev_sms_secret
EMAIL_SMTP_HOST=smtp.mailtrap.io
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
{{- end }}

# ============================================================
# 前端专用
# ============================================================
VITE_API_BASE=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_UPLOAD_LIMIT_MB=10
